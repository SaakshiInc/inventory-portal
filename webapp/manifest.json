{
  "_version": "1.48.0",
  "sap.app": {
    "id": "novamart.inventory",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "title": "{{appTitle}}",
    "description": "{{appSubtitle}}",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "dataSources": {
      "productsSource": {
        "uri": "model/products.json",
        "type": "JSON"
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "rootView": {
      "viewName": "novamart.inventory.view.App",
      "type": "XML",
      "async": true,
      "id": "app"
    },
    "dependencies": {
      "minUI5Version": "1.108.0",
      "libs": {
        "sap.ui.core": {},
        "sap.m": {},
        "sap.f": {},
        "sap.ui.layout": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "novamart.inventory.i18n.i18n",
          "supportedLocales": ["", "en", "de", "hi"],
          "fallbackLocale": ""
        }
      },
      "products": {
        "type": "sap.ui.model.json.JSONModel",
        "uri": "model/products.json"
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "viewType": "XML",
        "viewPath": "novamart.inventory.view",
        "controlId": "flexibleColumnLayout",
        "transition": "slide",
        "async": true
      },
      "routes": [
        {
          "name": "master",
          "pattern": "",
          "target": "master"
        },
        {
          "name": "detail",
          "pattern": "product/{productId}",
          "target": ["master", "detail"]
        },
        {
          "name": "notFound",
          "pattern": ":all*:",
          "target": "notFound"
        }
      ],
      "targets": {
        "master": {
          "viewName": "List",
          "viewLevel": 1,
          "controlAggregation": "beginColumnPages"
        },
        "detail": {
          "viewName": "Detail",
          "viewLevel": 2,
          "controlAggregation": "midColumnPages"
        },
        "notFound": {
          "viewName": "NotFound",
          "viewLevel": 3,
          "controlAggregation": "midColumnPages"
        }
      }
    }
  }
}
