<mvc:View
	controllerName="novamart.inventory.controller.App"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns="sap.f"
	xmlns:m="sap.m"
	displayBlock="true">
	<m:Shell id="shell" appWidthLimited="false">
		<FlexibleColumnLayout
			id="flexibleColumnLayout"
			stateChange=".onStateChange"
			layout="{appView>/layout}">
		</FlexibleColumnLayout>
	</m:Shell>
</mvc:View>
